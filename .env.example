# Supabase Postgres via the session pooler (port 5432).
# Replace <password> with your Supabase database password (URL-encode special chars, e.g. @ -> %40).
# The region (aws-0-ap-southeast-1) depends on your project.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_WS_URL="ws://localhost:1234"
COLLAB_PORT=1234
apiVersion: v1
kind: Secret
metadata:
  name: google-docs-secrets
  labels:
    app: google-docs
type: Opaque
stringData:
  # Replace with: openssl rand -base64 32
  AUTH_SECRET: "<replace-me>"
  # Replace with your Supabase session pooler URL (port 5432)
  # URL-encode special chars in password (e.g. @ -> %40)
  DATABASE_URL: "postgresql://postgres.<project-ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"
